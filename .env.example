# Painel web
PANEL_PORT=3000
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha
SESSION_SECRET=

# Servidor RTMP / HTTP-FLV
RTMP_PORT=1935
HTTP_MEDIA_PORT=8000

# Host/IP público usado nas URLs exibidas no painel (ex.: meuservidor.com)
PUBLIC_HOST=

# Caminhos dos binários (deixe assim se estiverem no PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp

# Formato do yt-dlp (padrão prioriza H.264+AAC até 1080p para cópia direta)
#YTDLP_FORMAT=

# Cookies do yt-dlp (formato Netscape) — use se o YouTube bloquear o IP do
# servidor ("Sign in to confirm you're not a bot"). Exporte do seu navegador
# com uma extensão como "Get cookies.txt" e aponte o caminho aqui.
#YTDLP_COOKIES=/app/data/cookies.txt

# Limite de upload por arquivo, em MB
MAX_UPLOAD_MB=4096

# true = aceita publicação RTMP com qualquer chave (não recomendado)
ALLOW_ANY_PUBLISH=false

# ---- Desempenho ----

# Watchdog: reinicia o ffmpeg se ficar este tempo sem progresso (0 desativa)
STALL_TIMEOUT_SEC=45

# Gera HLS (.m3u8) de cada stream — roda em iPhone/SmartTV/navegador
HLS_ENABLED=true

# Cache de GOP: true = imagem instantânea ao entrar (alguns s atrás do vivo);
# false = entra colado no vivo, mas espera o próximo keyframe para exibir
GOP_CACHE=true

# Grade de programação
# Fuso horário usado pela grade (ex.: America/Sao_Paulo)
TZ=
# Ao trocar de bloco, espera o programa atual terminar (até este limite, em s)
BLOCK_GRACE_MAX_SEC=600
# Frequência (s) com que o agendador confere se a grade mudou de bloco
SCHEDULER_INTERVAL_SEC=20
# Horizonte (s) da transição sem corte entre blocos (regenera ao fim)
SEAMLESS_HORIZON_SEC=21600

# Threads do ffmpeg nos streams ao vivo (vazio = automático)
FFMPEG_THREADS=

# Normalização no upload: converte cada vídeo uma vez para um perfil uniforme.
# Canais no modo "normalizado" transmitem com -c copy (CPU quase zero).
NORMALIZE_ENABLED=true
NORMALIZE_RESOLUTION=1280x720
NORMALIZE_FPS=30
NORMALIZE_VIDEO_BITRATE=2500k
NORMALIZE_AUDIO_BITRATE=128k
NORMALIZE_PRESET=veryfast
# Threads da normalização (vazio = automático; ela já roda com prioridade baixa)
NORMALIZE_THREADS=
# Quantos vídeos normalizar em paralelo
NORMALIZE_CONCURRENCY=1
# Detecta vídeos enviados já no padrão e pula o re-encode (só reempacota)
NORMALIZE_SMART=true
# Normalização de loudness EBU R128 (padroniza volume entre programas/comerciais)
NORMALIZE_LOUDNORM=true
NORMALIZE_LOUDNORM_TARGET=I=-16:TP=-1.5:LRA=11
# Fonte para textos sobrepostos (classificação indicativa). Vazio = autodetecta
FONT_PATH=
