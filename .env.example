# Painel web
PANEL_PORT=3000
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha
SESSION_SECRET=

# Servidor RTMP / HTTP-FLV
RTMP_PORT=1935
HTTP_MEDIA_PORT=8000

# Host/IP público usado nas URLs exibidas no painel (ex.: meuservidor.com)
PUBLIC_HOST=

# Caminhos dos binários (deixe assim se estiverem no PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Limite de upload por arquivo, em MB
MAX_UPLOAD_MB=4096

# true = aceita publicação RTMP com qualquer chave (não recomendado)
ALLOW_ANY_PUBLISH=false
